# Local-only configuration. Copy this file to .env and replace every value.
# Never commit the .env file.

# Required for hospital and police-station lookup after an incident.
MAPBOX_ACCESS_TOKEN=PASTE_NEW_MAPBOX_TOKEN_HERE

# Required for Telegram SOS and emergency dispatches.
TELEGRAM_BOT_TOKEN=PASTE_NEW_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=PASTE_YOUR_TELEGRAM_CHAT_ID_HERE

# Optional. Set only for an authorised police testing/dispatch chat.
TELEGRAM_POLICE_CHAT_ID=

# Optional: replaces the generated-per-startup Flask session key.
SAFEDRIVE_SECRET_KEY=PASTE_A_LONG_RANDOM_SECRET_HERE
